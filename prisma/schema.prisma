generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model appointment {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id        String                   @db.Uuid
  patient_id       String                   @db.Uuid
  service_id       String                   @db.Uuid
  address_snapshot String                   @db.VarChar(100)
  phone_snapshot   String                   @db.VarChar(8)
  appointment_date DateTime                 @db.Timestamp(6)
  status           status_appointment_type? @default(PENDING)
  notes            String                   @db.VarChar(200)
  doctor_comment   String?                  @db.VarChar(200)
  created_at       DateTime?                @db.Timestamp(6)
  updated_at       DateTime?                @db.Timestamp(6)
  doctor           doctor                   @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_appointment_doctor")
  patient          patient                  @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_appointment_patient")
  service          service                  @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_appointment_service")
}

model doctor {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @db.VarChar(100)
  lastname     String        @db.VarChar(100)
  rut          String        @unique @db.VarChar(9)
  phone_number String        @db.VarChar(8)
  user_id      String        @unique @db.Uuid
  created_at   DateTime?     @db.Timestamp(6)
  updated_at   DateTime?     @db.Timestamp(6)
  appointment  appointment[]
  user         user          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_doctor_user")
  schedule     schedule[]
}

model patient {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @db.VarChar(100)
  lastname     String        @db.VarChar(100)
  rut          String        @unique @db.VarChar(9)
  birthday     DateTime      @db.Timestamp(6)
  phone_number String        @db.VarChar(8)
  email        String        @unique @db.VarChar(100)
  address      String        @db.VarChar(100)
  created_at   DateTime?     @db.Timestamp(6)
  updated_at   DateTime?     @db.Timestamp(6)
  appointment  appointment[]
}

model schedule {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id    String    @db.Uuid
  day_of_week  Int
  start_time   String    @db.VarChar(50)
  end_time     String    @db.VarChar(50)
  is_available Boolean?  @default(true)
  created_at   DateTime? @db.Timestamp(6)
  updated_at   DateTime? @db.Timestamp(6)
  doctor       doctor    @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_schedule_doctor")

  @@unique([doctor_id, day_of_week, start_time], map: "unique_doctor_schedule")
}

model service {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String        @db.VarChar(100)
  name        String        @db.VarChar(100)
  description String
  price       Int
  is_active   Boolean?      @default(true)
  created_at  DateTime?     @db.Timestamp(6)
  updated_at  DateTime?     @db.Timestamp(6)
  appointment appointment[]
}

model user {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String      @unique @db.VarChar(100)
  password   String      @db.VarChar(200)
  role       role_type   @default(PATIENT)
  status     status_type @default(INACTIVE)
  created_at DateTime?   @db.Timestamp(6)
  updated_at DateTime?   @db.Timestamp(6)
  doctor     doctor?
}

enum role_type {
  ADMIN
  DOCTOR
  PATIENT
}

enum status_appointment_type {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum status_type {
  SUSPENDED
  ACTIVE
  INACTIVE
}
